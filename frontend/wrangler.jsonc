{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eusebiu-tamas-personal-portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
